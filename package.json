{
  "name": "megabeer",
  "private": true,
  "version": "1.0.0-dev",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "yarn run build && wrangler dev",
    "deploy": "yarn run build && wrangler deploy"
  },
  "dependencies": {
    "three": "^0.185.1",
    "three-mesh-bvh": "^0.9.18"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.45.1",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^5.1.0",
    "wrangler": "^4.112.0"
  },
  "packageManager": "yarn@4.17.1"
}
