{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "megabeer",
  "compatibility_date": "2026-07-19",
  // Le Worker (comptes, sauvegarde) ne répond qu'à /api ; tout le reste est servi tel quel depuis dist/
  "main": "worker/index.ts",
  "observability": {
    "enabled": true
  },
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "megabeer",
      "database_id": "A_REMPLIR",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Identifiant public de l'application Discord (le secret, lui, est un secret Cloudflare : DISCORD_CLIENT_SECRET)
    "DISCORD_CLIENT_ID": ""
  }
}
